@model Pedrito.Models.Client
@{
    ViewData["Title"] = "Client Details";
}
<h2>Client Details</h2>
<div class="card">
    <div class="card-body">
    <h5 class="card-title">@Model.FirstName @Model.LastName</h5>
        <p class="card-text"><strong>Email:</strong> @Model.Email</p>
        <p class="card-text"><strong>Phone:</strong> @Model.Phone</p>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    </div>
</div>
