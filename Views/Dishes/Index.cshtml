@model IEnumerable<Pedrito.Models.Dish>
@{
    ViewData["Title"] = "Dishes List";
}
<h2>Dishes</h2>
@if (TempData["message"] != null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}
<a asp-action="Create" class="btn btn-primary mb-2">Add Dish</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var dish in Model)
    {
        <tr>
            <td>@dish.Name</td>
            <td>@dish.Description</td>
            <td>@dish.Price</td>
            <td>@dish.Category</td>
            <td>
                <a asp-action="Details" asp-route-id="@dish.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Edit" asp-route-id="@dish.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@dish.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
