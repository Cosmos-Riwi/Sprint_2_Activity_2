@model Pedrito.Models.Reservation
@{
    ViewData["Title"] = "Edit Reservation";
    var clients = ViewBag.Clients as List<Pedrito.Models.Client>;
}
<h2>Edit Reservation</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="ReservationDate" class="form-label"></label>
        <input asp-for="ReservationDate" class="form-control" type="date" />
    </div>
    <div class="mb-3">
        <label asp-for="ReservationTime" class="form-label"></label>
        <input asp-for="ReservationTime" class="form-control" type="time" />
    </div>
    <div class="mb-3">
        <label asp-for="PartySize" class="form-label"></label>
        <input asp-for="PartySize" class="form-control" type="number" min="1" />
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <input asp-for="Notes" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ClientId" class="form-label">Client</label>
        <select asp-for="ClientId" class="form-control">
            <option value="">Select a client</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id" selected="@(client.Id == Model.ClientId)">@client.FirstName @client.LastName</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
