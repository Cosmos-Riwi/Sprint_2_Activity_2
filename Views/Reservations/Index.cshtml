@model IEnumerable<Pedrito.Models.Reservation>
@{
    ViewData["Title"] = "Reservations List";
}
<h2>Reservations</h2>
@if (TempData["message"] != null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}
<a asp-action="Create" class="btn btn-primary mb-2">Add Reservation</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Party Size</th>
            <th>Notes</th>
            <th>Client</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var reservation in Model)
    {
        <tr>
            <td>@reservation.ReservationDate.ToShortDateString()</td>
            <td>@reservation.ReservationTime</td>
            <td>@reservation.PartySize</td>
            <td>@reservation.Notes</td>
            <td>@reservation.Client?.FirstName @reservation.Client?.LastName</td>
            <td>
                <a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Edit" asp-route-id="@reservation.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@reservation.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
