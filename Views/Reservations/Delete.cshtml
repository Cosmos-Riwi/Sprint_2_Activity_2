@model Pedrito.Models.Reservation
@{
    ViewData["Title"] = "Delete Reservation";
}
<h2>Delete Reservation</h2>
<div class="alert alert-danger">
    Are you sure you want to delete this reservation?
</div>
<div>
    <dl class="row">
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.ReservationDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Time</dt>
        <dd class="col-sm-10">@Model.ReservationTime</dd>
        <dt class="col-sm-2">Party Size</dt>
        <dd class="col-sm-10">@Model.PartySize</dd>
        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@Model.Notes</dd>
        <dt class="col-sm-2">Client</dt>
        <dd class="col-sm-10">@Model.Client?.FirstName @Model.Client?.LastName</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
