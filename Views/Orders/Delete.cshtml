@model Pedrito.Models.Order
@{
    ViewData["Title"] = "Delete Order";
}
<h2>Delete Order</h2>
<div class="alert alert-danger">
    Are you sure you want to delete this order?
</div>
<div>
    <dl class="row">
        <dt class="col-sm-2">Order Number</dt>
        <dd class="col-sm-10">@Model.OrderNumber</dd>
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.OrderDate</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        <dt class="col-sm-2">Client</dt>
        <dd class="col-sm-10">@Model.Client?.FirstName @Model.Client?.LastName</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
