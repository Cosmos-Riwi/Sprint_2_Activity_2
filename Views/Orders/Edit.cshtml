@model Pedrito.Models.Order
@{
    ViewData["Title"] = "Edit Order";
    var clients = ViewBag.Clients as List<Pedrito.Models.Client>;
}
<h2>Edit Order</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="OrderNumber" class="form-label"></label>
        <input asp-for="OrderNumber" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="OrderDate" class="form-label"></label>
        <input asp-for="OrderDate" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Pedrito.Models.OrderStatus>()" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label asp-for="ClientId" class="form-label">Client</label>
        <select asp-for="ClientId" class="form-control">
            <option value="">Select a client</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id" selected="@(client.Id == Model.ClientId)">@client.FirstName @client.LastName</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
