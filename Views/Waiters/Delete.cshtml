@model Pedrito.Models.Waiter
@{
    ViewData["Title"] = "Delete Waiter";
}
<h2>Delete Waiter</h2>
<div class="alert alert-danger">
    Are you sure you want to delete this waiter?
</div>
<div>
    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>
        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">Shift</dt>
        <dd class="col-sm-10">@Model.Shift</dd>
        <dt class="col-sm-2">Years Experience</dt>
        <dd class="col-sm-10">@Model.YearsExperience</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
